{
  "workflows": {
    "Nightly": {
      "version": "0.12.0",
      "name": "Nightly",
      "name_slug": "nightly",
      "job_timeout": 20,
      "default_branch": "main",
      "container_runtime": "podman",
      "workflow_key": "nightly",
      "workflow_config": {
        "type": "nightly",
        "trigger_manual": true,
        "trigger_cron": true,
        "trigger_cron_schedule": "19 0 * * 5",
        "trigger_schedule_branches": [
          "main"
        ],
        "environment_pattern": "nightly-.*"
      },
      "network_global": [
        "keyserver.ubuntu.com:443",
        "github.com:443",
        "api.github.com:443",
        "codeload.github.com:443",
        "uploads.github.com:443",
        "objects.githubusercontent.com:443",
        "raw.githubusercontent.com:443",
        "release-assets.githubusercontent.com:443",
        "ghcr.io:443",
        "pkg-containers.githubusercontent.com:443"
      ],
      "plan": {
        "name": "main",
        "stages": [
          "build",
          "test",
          "scan"
        ],
        "steps": [
          {
            "id": "0",
            "name": "cargo-build [test-app-rust-cargo]",
            "slug": "cargo-build-test-app-rust-cargo",
            "stage": "build",
            "scope": "module",
            "action": "builtin://actions/cargo-build",
            "module": "cargo-cargo-toml",
            "module-dir": ".",
            "access": {
              "executables": [
                {
                  "name": "cargo",
                  "constraint": "\u003e= 0.0.0-0"
                }
              ],
              "network": [
                "http://crates.io:443|GET,HEAD",
                "http://index.crates.io:443|GET,HEAD",
                "http://static.crates.io:443|GET,HEAD:/crates/**",
                "crates.io:443"
              ]
            },
            "inputs": {},
            "outputs": {
              "artifacts": [
                {
                  "type": "binary"
                },
                {
                  "type": "crate"
                }
              ]
            },
            "order": 0
          },
          {
            "id": "1",
            "name": "cargo-test [test-app-rust-cargo]",
            "slug": "cargo-test-test-app-rust-cargo",
            "stage": "test",
            "scope": "module",
            "action": "builtin://actions/cargo-test",
            "module": "cargo-cargo-toml",
            "module-dir": ".",
            "access": {
              "executables": [
                {
                  "name": "cargo",
                  "constraint": "\u003e= 0.0.0-0"
                },
                {
                  "name": "cargo-nextest",
                  "constraint": "\u003e= 0.0.0-0"
                }
              ],
              "network": [
                "http://crates.io:443|GET,HEAD",
                "http://index.crates.io:443|GET,HEAD",
                "http://static.crates.io:443|GET,HEAD:/crates/**",
                "crates.io:443"
              ]
            },
            "inputs": {},
            "outputs": {
              "artifacts": [
                {
                  "type": "report",
                  "format": "junit"
                }
              ]
            },
            "order": 1
          },
          {
            "id": "2",
            "name": "betterleaks-scan",
            "slug": "betterleaks-scan",
            "stage": "scan",
            "scope": "project",
            "action": "builtin://actions/betterleaks-scan",
            "access": {
              "executables": [
                {
                  "name": "betterleaks",
                  "constraint": "\u003e= 0.0.0-0"
                }
              ],
              "resources": [
                "security-events"
              ]
            },
            "inputs": {},
            "outputs": {
              "artifacts": [
                {
                  "type": "report",
                  "format": "sarif"
                }
              ]
            },
            "order": 2
          },
          {
            "id": "3",
            "name": "semgrep-scan",
            "slug": "semgrep-scan",
            "stage": "scan",
            "scope": "project",
            "action": "builtin://actions/semgrep-scan",
            "access": {
              "env": [
                {
                  "name": "SEMGREP_RULES"
                },
                {
                  "name": "SEMGREP_APP_TOKEN",
                  "secret": true
                }
              ],
              "executables": [
                {
                  "name": "semgrep",
                  "constraint": "\u003e= 0.0.0-0"
                }
              ],
              "network": [
                "http://semgrep.dev:443|GET,HEAD|POST,PUT:/api/**"
              ],
              "resources": [
                "security-events"
              ]
            },
            "inputs": {},
            "outputs": {
              "artifacts": [
                {
                  "type": "report",
                  "format": "sarif"
                }
              ]
            },
            "order": 3
          },
          {
            "id": "4",
            "name": "trivyfs-scan",
            "slug": "trivyfs-scan",
            "stage": "scan",
            "scope": "project",
            "action": "builtin://actions/trivyfs-scan",
            "access": {
              "executables": [
                {
                  "name": "trivy",
                  "constraint": "\u003e 0.69.6"
                }
              ],
              "network": [
                "http://mirror.gcr.io:443|GET,HEAD"
              ],
              "resources": [
                "security-events"
              ]
            },
            "inputs": {},
            "outputs": {
              "artifacts": [
                {
                  "type": "report",
                  "format": "sarif"
                }
              ]
            },
            "order": 4
          },
          {
            "id": "5",
            "name": "sonarqube-scan",
            "slug": "sonarqube-scan",
            "stage": "scan",
            "scope": "project",
            "action": "builtin://actions/sonarqube-scan",
            "run-after": [
              "betterleaks-scan",
              "cargo-test-test-app-rust-cargo",
              "semgrep-scan",
              "trivyfs-scan"
            ],
            "run-after-by-name": [
              "betterleaks-scan",
              "cargo-test [test-app-rust-cargo]",
              "semgrep-scan",
              "trivyfs-scan"
            ],
            "uses-output-of": [
              "betterleaks-scan",
              "cargo-test-test-app-rust-cargo",
              "semgrep-scan",
              "trivyfs-scan"
            ],
            "uses-output-of-by-name": [
              "betterleaks-scan",
              "cargo-test [test-app-rust-cargo]",
              "semgrep-scan",
              "trivyfs-scan"
            ],
            "access": {
              "env": [
                {
                  "name": "SONAR_HOST_URL"
                },
                {
                  "name": "SONAR_ORGANIZATION"
                },
                {
                  "name": "SONAR_PROJECTKEY"
                },
                {
                  "name": "SONAR_DEFAULT_BRANCH"
                },
                {
                  "name": "SONAR_REGION"
                },
                {
                  "name": "SONAR_TOKEN",
                  "required": true,
                  "secret": true
                }
              ],
              "executables": [
                {
                  "name": "sonar-scanner",
                  "constraint": "\u003e= 0.0.0-0"
                }
              ],
              "network": [
                "sonarcloud.io:443",
                "api.sonarcloud.io:443",
                "scanner.sonarcloud.io:443"
              ]
            },
            "inputs": {
              "artifacts": [
                {
                  "type": "report",
                  "format": "junit"
                },
                {
                  "type": "report",
                  "format": "cobertura"
                },
                {
                  "type": "report",
                  "format": "jacoco"
                },
                {
                  "type": "report",
                  "format": "trx"
                },
                {
                  "type": "report",
                  "format": "go-coverage"
                },
                {
                  "type": "report",
                  "format": "sarif"
                }
              ]
            },
            "outputs": {},
            "order": 5
          }
        ]
      },
      "workflow_dependency": {
        "pkg:github-action-runner-image/ubuntu": {
